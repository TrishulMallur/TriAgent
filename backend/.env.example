# Copy this file to backend/.env and fill in your keys.
# This file is safe to commit — it contains no real secrets.

AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_claude_key_here

# Comma-separated list of origins allowed to call this API.
# Local defaults are baked into main.py if this is unset.
# On Railway, set this to the Vercel deployment URL once known, e.g.:
#   ALLOWED_ORIGINS=https://triagent.vercel.app,https://triagent-git-main-yourname.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://localhost:5175

# Per-IP rate limit for the LLM-proxy + document-extraction endpoints
# (requests per rolling 60s window). The shared X-API-Key ships in the public
# frontend bundle, so this caps open-relay / DoS abuse. Set to 0 to disable.
RATE_LIMIT_PER_MINUTE=120
