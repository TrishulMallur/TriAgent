# [WARNING] SECURITY WARNING, DO NOT use VITE_*_API_KEY for production deploys.
# Anything prefixed VITE_ is embedded in the JavaScript bundle at build time
# and visible to every browser that loads the app. Use the backend provider
# (VITE_USE_BACKEND=true + VITE_API_BASE_URL=...) and keep keys server-side.
# The VITE_*_API_KEY plumbing is here for local development only.

# Claude API Key, get yours at console.anthropic.com
VITE_ANTHROPIC_API_KEY=your_claude_key_here

# Google Gemini API Key, get yours at aistudio.google.com
VITE_GEMINI_API_KEY=your_gemini_key_here

# LM Studio local endpoint (default port 1234)
VITE_LMSTUDIO_URL=http://localhost:1234

# llama.cpp local server endpoint — default port 8080
# Start with: ./llama-server -m model.gguf
VITE_LLAMACPP_URL=http://localhost:8080

# Default LLM provider: claude | gemini | lmstudio | llamacpp | mock
VITE_DEFAULT_PROVIDER=mock

# Backend routing toggle (true = route AI calls through FastAPI backend)
VITE_USE_BACKEND=false

# Backend API URL (if using FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000

# Optional: dev-only AI keys (baked into the browser bundle in dev, NEVER for production).
# Visitors to a public deploy paste their own key via the UI; don't rely on these.
VITE_OPENAI_API_KEY=
VITE_OPENROUTER_API_KEY=
